# ==============================================================================
# GLAMGO - HAUTE BEAUTÉ MARKETPLACE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000

# Client Configuration
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_SKELETON_DEBUG=false

# Core Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://glamgo_admin:glamgo_secret_pass@localhost:5432/glamgo_db?schema=public

# Redis Connection (Distributed Locks, Slot Reserving, SSE Streaming)
# Format: redis://[:PASSWORD@]HOST:PORT
REDIS_URL=redis://localhost:6379

# Escrow & Payment Gateway (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_live_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret

# CORS Allowed Origins (Comma-separated in production)
CORS_ORIGIN=https://glamgo.in,https://www.glamgo.in,https://glamgo.vercel.app

# Telemetry & Monitoring
ENABLE_SSE_LOGGING=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
