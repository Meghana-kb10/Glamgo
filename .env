# Database Credentials
POSTGRES_USER=glamgo_admin
POSTGRES_PASSWORD=glamgo_secret_pass
POSTGRES_DB=glamgo_db
POSTGRES_PORT=5434

# Prisma Database Connection String
DATABASE_URL="postgresql://glamgo_admin:glamgo_secret_pass@localhost:5434/glamgo_db?schema=public"

# Redis Connection (Atomic 10-Minute Redlock)
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# Backend API Server
PORT=4000
NODE_ENV=development
